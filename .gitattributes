# Keep the cross-host evidence byte-identical on every checkout: the
# SHA256SUMS manifest is computed over exact LF bytes, so these files must
# never undergo end-of-line conversion regardless of a clone's core.autocrlf.
docs/results/table2-reorder3-crosshost-20261122/** -text
scripts/crosshost_preflight.sh text eol=lf
scripts/crosshost_build_reorder3.sh text eol=lf
scripts/crosshost_run_reorder3.sh text eol=lf
docs/results/table1-cve/** -text
docs/results/table1-cve/** -text
scripts/cve_run.sh text eol=lf
scripts/cve_run_rep.sh text eol=lf
scripts/cve_build_all.sh text eol=lf
scripts/cve_repeat_loop.sh text eol=lf
scripts/cve_stats.py text eol=lf
docs/results/worker-syscall-evidence/** -text
docs/results/table2-reorder-schedules/** -text
# Every shell/python script must stay LF on Windows checkouts too, otherwise
# bash fails with "$'\r': command not found". Keep these last (last rule wins).
scripts/*.sh text eol=lf
scripts/*.py text eol=lf
